# Scalar voice agent worker. Copy to .env.local for local dev.
#
# NOTE what is deliberately absent: there is no DATABASE_URL, no
# POSTGRES_PRISMA_URL, no Clerk key, no Stripe key. This worker never touches
# the database. It reaches the CRM only through the internal HTTP API below.

# ── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Default outbound SIP trunk. Per tenant trunks override this via job metadata.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Must match the agentName in the SIP dispatch rule and in every outbound
# dispatch created by the control plane.
VOICE_AGENT_NAME=scalar-agent

# ── The internal API on the Next.js app ─────────────────────────────────────
SCALAR_INTERNAL_API_URL=https://app.scalar.example
SCALAR_INTERNAL_SECRET=
SCALAR_INTERNAL_TIMEOUT_MS=10000

# ── Model providers ─────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Only when VOICE_TTS_PROVIDER=elevenlabs
# ELEVEN_API_KEY=
# Only when a google provider is selected
# GOOGLE_API_KEY=

# ── Model selection (change the voice without a redeploy) ───────────────────
VOICE_STT_PROVIDER=deepgram
VOICE_STT_MODEL=nova-3
VOICE_STT_LANGUAGE=en-US
VOICE_LLM_PROVIDER=openai
VOICE_LLM_MODEL=gpt-4o-mini
VOICE_LLM_TEMPERATURE=0.3
VOICE_TTS_PROVIDER=cartesia
VOICE_TTS_MODEL=sonic-2
VOICE_TTS_VOICE=794f9389-aac1-45b6-b726-9d9369183238

# ── Call behaviour ──────────────────────────────────────────────────────────
VOICE_MAX_CALL_DURATION_SEC=600
VOICE_RINGING_TIMEOUT_SEC=30
VOICE_KRISP_ENABLED=true

# ── Recording ───────────────────────────────────────────────────────────────
# Redaction is the PII lever on stored call audio. Turning it off is a legal
# decision, not a performance one.
VOICE_RECORDING_REDACTION=true
VOICE_RECORD_AUDIO=true
VOICE_RECORD_TRANSCRIPT=true
VOICE_RECORD_TRACES=true

LOG_LEVEL=info
