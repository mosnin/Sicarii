// Scalar — Prisma schema (Postgres on Supabase)
// Auth is Clerk; users are mirrored here via the Clerk webhook.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Read the Supabase Vercel integration's auto-injected vars directly so no
  // manual env control is needed. POSTGRES_PRISMA_URL = pooled (pgbouncer),
  // POSTGRES_URL_NON_POOLING = direct connection (migrations / db push).
  url        = env("POSTGRES_PRISMA_URL")
  directUrl  = env("POSTGRES_URL_NON_POOLING")
  // pgvector powers the agent's token-efficient recall (memory_chunks.embedding).
  extensions = [vector]
}

model User {
  id               String    @id @default(uuid())
  clerkId          String    @unique
  email            String
  firstName        String?
  lastName         String?
  imageUrl         String?
  role             String    @default("member")
  // "user" = a human account. "workspace" = a synthetic account row mirroring a
  // Clerk Organization: it owns the team's shared data through the exact same
  // userId scoping every query already uses (see docs/engineering/
  // teams-plan-2026-07-11.md). Human-only flows (welcome, profile) gate on this.
  accountType      String    @default("user")
  // Operator-authored context the agent reads (what you're selling) + a
  // connected AgentMail key for email. Both are per-user settings.
  productContext   String?   @db.Text
  agentMailApiKey  String?
  agentPhoneApiKey String?
  // Outbound webhook: where Scalar POSTs results when a scheduled task (intent
  // monitor / research schedule) completes, so the user's agent can be woken up.
  taskWebhookUrl   String?
  // Away-window guarantee: when true (default), finishing the first run seeds a
  // weekly ICP radar so the agent keeps working while the user is away (powers
  // The Pulse). The Settings toggle flips this AND pauses/resumes the seeded
  // monitor, so it is a real off switch, not just a future-seeding preference.
  autoRadar        Boolean   @default(true)
  // Billing: plan + credit meter. Existing users default to "beta" with 10,000
  // credits so nobody is suddenly blocked; new signups are set to "free"/200 by
  // the Clerk webhook at creation time. creditsResetAt is the next monthly
  // refill; stripeCustomerId links to the Stripe customer once they pay.
  plan             String    @default("beta")
  creditsRemaining Int       @default(10000)
  creditsResetAt   DateTime?
  stripeCustomerId String?
  // Reporting currency: the denomination of every PipelineEntry.baseAmount and
  // therefore of every total, chart and sort. Changing it re-rates open deals.
  // Plain column, no unique index - see the voiceInboundSecret note below for
  // why an ALTER on `users` must never add one.
  reportingCurrency String   @default("USD")
  // Stamped on every dashboard load; the prior value is the "while you were
  // away" window for The Pulse. Null until the first dashboard visit, so a
  // returning user never sees their whole history bragged back at them.
  lastSeenAt       DateTime?
  // Voice-native CRM (inbound): the operator calls their AgentPhone number and
  // asks Scalar a question out loud. voiceEnabled is the explicit opt-in (off
  // by default, and requires agentPhoneApiKey to turn on). voiceInboundSecret
  // is a high-entropy, per-user token the operator pastes into their
  // AgentPhone inbound-webhook config as ?key=<token> - it is the ONLY thing
  // that authenticates an inbound call to this user, since AgentPhone's
  // payload shape/signing is unverified and nothing in the call body is ever
  // trusted for identity. See src/app/api/webhooks/agentphone/route.ts.
  // NOTE: this is deliberately NOT @unique at the DB level - a UNIQUE INDEX on
  // this Supabase project's `users` table fails `prisma db push` (confirmed:
  // every sibling PR that only ADDS a table deploys green; this is the only
  // one that ALTERs `users`, and only the @unique variant failed). Uniqueness
  // is instead guaranteed at generation time in
  // src/app/api/settings/voice/route.ts (collision-checked before save), and
  // lookups use findFirst against the plain index below.
  voiceEnabled       Boolean   @default(false)
  voiceInboundSecret String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entities          Entity[]
  contacts          Contact[]
  apiKeys           ApiKey[]
  conversations     Conversation[]
  memoryChunks      MemoryChunk[]
  intentMonitors    IntentMonitor[]
  researchSchedules ResearchSchedule[]
  swarmRuns         SwarmRun[]
  creditLedger      CreditLedger[]
  activities        Activity[]
  segments          Segment[]
  pipelines         Pipeline[]
  outreachVariants  OutreachVariant[]
  // Teams: workspaces this human belongs to / humans in this workspace.
  memberships       TeamMember[] @relation("MemberOf")
  members           TeamMember[] @relation("WorkspaceMembers")
  // Budgeted Autopilot: proposed/approved spend plans that run unsupervised
  // within their approved credit ceiling.
  autopilotPlans    AutopilotPlan[]
  breakupDrafts     BreakupDraft[]

  // Connected mailboxes/calendars (Composio), the synced records they produce,
  // the suppression lists, the evidence ledger, user-defined fields and the
  // durable task queue. All userId-scoped like everything else.
  connectedAccounts  ConnectedAccount[]
  emailThreads       EmailThread[]
  emailMessages      EmailMessage[]
  calendarEvents     CalendarEvent[]
  suppressedDomains  SuppressedDomain[]
  suppressedContacts SuppressedContact[]
  recordFacts        RecordFact[]
  fieldDefinitions   FieldDefinition[]
  fieldValues        FieldValue[]
  agentTasks         AgentTask[]

  // Social context (SocQ): hydrated profiles/posts on records, plus the watch
  // list and its reviewable opportunities.
  socqTasks           SocqTask[]
  socialProfiles      SocialProfile[]
  socialPosts         SocialPost[]
  socialMonitors      SocialMonitor[]
  socialOpportunities SocialOpportunity[]

  // In-house telephony (LiveKit): numbers bought through the platform and the
  // calls placed on them.
  phoneNumbers PhoneNumber[]
  voiceCalls   VoiceCall[]

  // Sequences: cadences this tenant owns and the contacts enrolled in them.
  sequences           Sequence[]
  sequenceEnrollments SequenceEnrollment[]

  // Per-tenant FX rates backing every deal total.
  exchangeRates ExchangeRate[]

  // Plain (non-unique) index for the webhook's findFirst lookup by secret -
  // see the voiceInboundSecret comment above for why this is not @unique.
  @@index([voiceInboundSecret])
  @@map("users")
}

// Mirror of a Clerk Organization membership: which humans can operate a
// workspace account and with what role. Kept in sync by the Clerk webhook and
// provisioned on first sight by the resolvers (same pattern as User).
model TeamMember {
  id                String   @id @default(uuid())
  workspaceId       String // users.id of the workspace account row
  workspace         User     @relation("WorkspaceMembers", fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String // users.id of the human member
  user              User     @relation("MemberOf", fields: [userId], references: [id], onDelete: Cascade)
  role              String   @default("member") // mirrors the Clerk org role
  clerkMembershipId String?  @unique
  createdAt         DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("team_members")
}

// Append-only record of every credit movement (debits from metered actions,
// refills on plan change). Best-effort: the atomic decrement on User is the
// source of truth; this is the audit trail.
model CreditLedger {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  action       String
  ref          String? // e.g. the contact/entity id the spend was for
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

// A chat with the Scalar agent. A fresh one is created on each page load; long-term
// continuity comes from vector recall over memory_chunks, not from replaying history.
model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// Token-efficient memory: embedded snippets of past messages and CRM data the agent
// can recall by similarity instead of stuffing everything into the prompt.
model MemoryChunk {
  id        String                       @id @default(uuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "message" | "entity" | "contact" | "email"
  refId     String? // id of the source record
  content   String                       @db.Text
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())

  @@index([userId])
  @@map("memory_chunks")
}

// Per-user API key for the MCP server / REST API. We store only a SHA-256 hash;
// the plaintext is shown once at creation. `prefix`/`last4` are for display.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  hashedKey  String    @unique
  prefix     String
  last4      String
  // For workspace keys: the human member (users.id) who minted it.
  createdById String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

// A business in the CRM. Discovered (e.g. via Tavily), enriched (via Explorium
// by domain), and operated on by agents. Has many contacts.
model Entity {
  id     String @id @default(uuid())
  userId String // owner (the Scalar account)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  domain      String?
  website     String?
  logoUrl     String?
  phone       String?
  industry    String?
  location    String?
  // Geocoded coordinates for the map view (from `location`, via Nominatim).
  lat         Float?
  lng         Float?
  geocodedAt  DateTime?
  description String?   @db.Text
  size        String?

  status EntityStatus @default(NEW)
  source String? // "agent:tavily", "manual", "agent", etc.
  tags   String[]     @default([])
  notes  String?      @db.Text

  // Enrichment payload (provider-shaped JSON the agent can read/extend).
  enrichment Json?

  // When this row is a copy shared from another account (personal -> team).
  sharedFromId String?

  contacts   Contact[]
  activities Activity[]

  emailThreads   EmailThread[]
  calendarEvents CalendarEvent[]
  fieldValues    FieldValue[]
  agentTasks     AgentTask[]
  socialProfiles SocialProfile[]
  socialPosts    SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([userId, createdAt])
  @@index([userId, domain])
  @@map("entities")
}

enum EntityStatus {
  NEW
  ENRICHED
  ARCHIVED
}

// Shared geocode cache. Keyed by a normalized address string so the same city
// or address is only ever sent to Nominatim once (1 req/sec policy), making
// repeated lookups instant. A row with null lat/lng is a remembered "no hit".
model GeocodeCache {
  id          String   @id @default(uuid())
  query       String   @unique
  lat         Float?
  lng         Float?
  displayName String?
  createdAt   DateTime @default(now())

  @@map("geocode_cache")
}

// A person/company in the CRM. Agents discover, enrich, and operate on these.
model Contact {
  id     String @id @default(uuid())
  userId String // owner (the Scalar account this contact belongs to)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional parent business. A contact is assigned to an entity or stands solo.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // Core
  name     String?
  email    String?
  phone    String?
  company  String?
  title    String?
  website  String?
  linkedin String?
  // Other social profiles (URL or handle). Filled manually, by an agent over
  // MCP, or by find_socials (strict name+company verification, see social-find).
  facebook  String?
  instagram String?
  twitter   String? // X (twitter.com / x.com)
  location String?
  imageUrl String?

  // Pipeline
  status ContactStatus @default(NEW)
  source String? // how it was found: "discover:domain", "manual", "import", etc.
  tags   String[]      @default([])
  notes  String?
  // Stamped by log_outreach when the agent reaches out; powers the
  // "who needs a follow-up" query (status is the qualitative state, this the
  // temporal one - updatedAt is polluted by every edit, so it can't be used).
  lastContactedAt DateTime?

  // Enrichment payload (provider-shaped JSON the agent can read/extend)
  enrichment Json?

  // When this row is a copy shared from another account (personal -> team),
  // the source contact's id, for provenance and re-share dedup.
  sharedFromId String?

  emails          ContactEmail[]
  calls           ContactCall[]
  socialMessages  ContactSocialMessage[]
  segments        ContactSegment[]
  pipelineEntries PipelineEntry[]
  activities      Activity[]
  breakupDrafts   BreakupDraft[]
  variantSends    VariantSend[]

  emailThreads      EmailThread[]
  emailMessages     EmailMessage[]
  calendarEvents    CalendarEvent[]
  calendarAttendees CalendarAttendee[]
  fieldValues       FieldValue[]
  agentTasks        AgentTask[]
  socialProfiles    SocialProfile[]
  socialPosts       SocialPost[]
  voiceCalls        VoiceCall[]
  sequenceEnrollments SequenceEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, status, lastContactedAt])
  @@index([entityId])
  @@index([userId, updatedAt])
  @@index([userId, createdAt])
  @@map("contacts")
}

// A timestamped trail of what happened with a contact or company: outreach
// sent, a reply, a call, a note, a status change. The generic activity log the
// ContactEmail model only covered for email. Keeps the human-summary `notes`
// field from being overwritten by agents and gives an honest history.
model Activity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic target: at least one is set.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  kind    String // "note" | "outreach" | "call" | "reply" | "status_change"
  body    String @db.Text
  channel String? // "email" | "linkedin" | "phone" | null
  // Attribution in a team workspace: userId above is the TENANT (the workspace
  // account); these say WHO acted - an agent's ApiKey.id or a member's users.id,
  // with a display snapshot so the feed stays readable after key rotation.
  actorId    String?
  actorLabel String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([contactId, createdAt])
  @@index([entityId, createdAt])
  @@map("activities")
}

// Idempotency ledger for incoming Stripe webhook events. The PK is the Stripe
// event.id; a duplicate delivery (Stripe is at-least-once + retries) fails the
// insert, so the handler can safely skip it before applying any mutation.
model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("processed_events")
}

// Atomic idempotency guard for credit grants (top-ups, plan purchases). The PK
// is "<userId>:<ref>" where ref is the single-use payment reference (x402 nonce
// or Stripe id). Inserting this row inside the same transaction as the credit
// mutation makes the grant exactly-once: a concurrent or retried grant with the
// same ref hits the PK collision (P2002) and the whole transaction rolls back,
// closing the check-then-act race that a bare findFirst() left open.
model IdempotencyKey {
  key       String   @id
  userId    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}

// Revocation list for OAuth refresh tokens (jti = the token's unique id). The
// MCP OAuth layer uses rotation-with-reuse-detection: each refresh consumes the
// presented token (its jti is inserted here) and issues a fresh one. A refresh
// token whose jti is already here is rejected, so a stolen-then-replayed token
// is caught the moment the legit client has rotated past it. Rows past the
// token's original expiry are prunable (the JWT exp already rejects them).
model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

enum ContactStatus {
  NEW
  ENRICHED
  CONTACTED
  REPLIED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

// Email exchanged with a contact. Rendered from the connected AgentMail account;
// the agent can save messages here as reusable context.
model ContactEmail {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // AgentMail linkage (nullable until a key is connected)
  agentMailMessageId String?
  agentMailThreadId  String?

  direction      Emaildirection
  fromAddr       String?
  toAddr         String?
  subject        String?
  body           String?        @db.Text
  // Whether the agent flagged this message as durable context.
  savedAsContext Boolean        @default(false)

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([contactId])
  @@index([agentMailThreadId])
  @@map("contact_emails")
}

enum Emaildirection {
  INBOUND
  OUTBOUND
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum SocialChannel {
  LINKEDIN
  X
  INSTAGRAM
  FACEBOOK
  OTHER
}

enum SocialDirection {
  INBOUND
  OUTBOUND
}

// A social media message (DM, comment thread, connection note) exchanged with a
// contact on LinkedIn, X, Instagram, or Facebook. Mirrors ContactEmail so the
// conversation history a user or agent tracks is durable and channel-labeled.
// Agents log these over MCP (log_social_message); humans log them from the
// contact page. threadRef is a permalink or external thread id when available.
model ContactSocialMessage {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  channel   SocialChannel
  direction SocialDirection
  body      String          @db.Text
  threadRef String?
  // Whether the agent flagged this message as durable context.
  savedAsContext Boolean @default(false)

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([contactId, createdAt])
  @@map("contact_social_messages")
}

// A phone call with a contact, placed/tracked via the user's AgentPhone account
// (per-user key on User.agentPhoneApiKey). Mirrors ContactEmail for calls so the
// agent's call history with a lead is durable and visible on the CRM.
model ContactCall {
  id        String  @id @default(uuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // AgentPhone linkage (nullable until a call is placed/synced).
  agentPhoneCallId String?

  direction      CallDirection
  fromNumber     String?
  toNumber       String?
  status         String? // in-progress / completed / failed
  durationSec    Int?
  summary        String? @db.Text
  transcript     String? @db.Text
  recordingUrl   String?
  savedAsContext Boolean @default(false)

  startedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([contactId])
  @@index([agentPhoneCallId])
  @@map("contact_calls")
}

// Recurring Exa intent monitor — runs on a schedule, delivers results via webhook.
// Results are attributed to userId and saved as entities tagged "intent".
model IntentMonitor {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  query        String    @db.Text
  frequency    String    @default("daily") // "daily" | "weekly" | "hourly"
  exaMonitorId String? // Exa's remote monitor ID (set after createExaMonitor succeeds)
  active       Boolean   @default(true)
  // When true, runs auto-add new records to the CRM. When false, runs are stored
  // for review and the user/agent can "Add to CRM" later.
  autoAdd      Boolean   @default(true)
  // True for the monitor auto-created from the ICP at first run, so the Settings
  // autoRadar toggle can pause/resume exactly that one (vs the user's own).
  autoSeeded   Boolean   @default(false)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  runs MonitorRun[]

  @@index([userId])
  @@index([active, nextRunAt])
  @@index([exaMonitorId])
  @@map("intent_monitors")
}

// A single execution of an intent monitor: what it pulled, and how much was added.
model MonitorRun {
  id         String        @id @default(uuid())
  userId     String
  monitorId  String
  monitor    IntentMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  items      Json? // the pulled results [{ title, url, summary }]
  found      Int           @default(0)
  added      Int           @default(0)
  addedToCrm Boolean       @default(false) // whether results were ingested
  createdAt  DateTime      @default(now())

  @@index([monitorId])
  @@index([userId])
  @@map("monitor_runs")
}

// A swarm discovery run: N parallel Exa search angles derived from (or given
// for) one broad goal, each run blind to the others, then merged and deduped
// across angles AND against the CRM. A separate model from MonitorRun on
// purpose: a MonitorRun always belongs to a recurring IntentMonitor, while a
// swarm is a one-off, on-demand multi-angle fan-out with no schedule and no
// parent monitor - forcing it through MonitorRun would mean a fake monitor row
// per run. This is the auditable record: what was searched, what came back per
// angle, what got merged/added/skipped, and which angle(s) surfaced each
// company (see docs/decisions/0011-swarm-discovery.md).
model SwarmRun {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal        String   @db.Text
  angles      String[] // the N angles actually run (explicit or derived)
  angleSource String   @default("derived") // "derived" | "explicit"

  found        Int @default(0) // raw company hits across all angles, before merge
  merged       Int @default(0) // unique companies after cross-angle dedup
  added        Int @default(0) // new entities created (merged minus CRM dupes)
  skipped      Int @default(0) // merged companies dropped as CRM duplicates
  creditsSpent Int @default(0) // actual credits debited (per angle that returned hits)

  // Results surface: { perAngle: [{angle,found,credited}], companies: [{companyName,domain,angles,status,entityId}] }
  items Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("swarm_runs")
}

// Scheduled deep research (Linkup or Exa) on a topic, contact, or entity.
// When targetType+targetId are set, research is merged into that record's notes.
// When null, top sources are saved as new entities.
model ResearchSchedule {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  query      String    @db.Text
  provider   String    @default("linkup") // "linkup" | "exa"
  depth      String    @default("deep") // "standard" | "deep"
  frequency  String    @default("daily") // "hourly" | "daily" | "weekly"
  targetType String? // "contact" | "entity" | null (saves as new records)
  targetId   String?
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([active, nextRunAt])
  @@map("research_schedules")
}

// ── Field: customer segments + agentic pipelines ────────────────────────────

// A customer segment: a named set of target contacts, built manually or from a
// prompt (OpenAI + vector match). FK to User so account deletion cascades.
model Segment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  goal      String?  @db.Text // the prompt/intent used to build it
  source    String? // "manual" | "prompt"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ContactSegment[]
  variants OutreachVariant[]

  @@index([userId])
  @@map("segments")
}

model ContactSegment {
  id        String   @id @default(uuid())
  segmentId String
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  score     Float? // vector match score 0-1
  createdAt DateTime @default(now())

  @@unique([segmentId, contactId])
  @@index([contactId])
  @@map("contact_segments")
}

// A pipeline: agentic deal flow. Contacts enter as PipelineEntry rows that track
// stage, deal score, and conversation status so agents don't loop forever.
model Pipeline {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  goal      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries PipelineEntry[]

  @@index([userId])
  @@map("pipelines")
}

enum PipelineStage {
  NEW
  ENRICHED
  PROSPECTING
  ENGAGING
  REPLYING
  WON
  LOST
}

enum ConversationStatus {
  OPEN
  AWAITING_REPLY
  STALLED
  CLOSED
}

model PipelineEntry {
  id                 String             @id @default(uuid())
  userId             String
  pipelineId         String
  pipeline           Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage              PipelineStage      @default(NEW)
  dealScore          Int? // 1-100 likelihood the deal closes
  conversationStatus ConversationStatus @default(OPEN)
  lastActivityAt     DateTime?

  // Money. `amount` + `currency` is what the customer pays and is never
  // converted in place. `baseAmount` (denominated in `baseCurrency`) is the
  // ONLY column any total, chart, average or sort may touch - summing
  // `amount` across currencies silently adds euros to dollars. The rate is
  // resolved once and frozen in fxRate/fxRateAt; converting on read makes a
  // closed quarter change value every morning. A missing rate leaves
  // baseAmount null - disclosed, not zeroed - so it falls out of _sum and can
  // be counted and reported as "not included".
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String?
  baseAmount        Decimal?  @db.Decimal(24, 4)
  baseCurrency      String?
  fxRate            Decimal?  @db.Decimal(20, 10)
  fxRateAt          DateTime?
  expectedCloseDate DateTime?

  fieldValues FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, contactId])
  @@index([userId])
  @@index([contactId])
  @@index([pipelineId, stage])
  @@map("pipeline_entries")
}

// ── Breakup drafts: stalled-deal pattern-interrupt emails ───────────────────
//
// Scalar notices a cold deal itself (see listStalledDeals in
// src/lib/breakup-operations.ts), drafts a polite "breakup" email grounded in
// the contact's real activity/email history, and holds it here PENDING for
// one-click human approval - it is never auto-sent. See
// docs/decisions/0012-breakup-drafts.md.

enum BreakupDraftStatus {
  PENDING
  APPROVED
  SENT
  DISMISSED
}

model BreakupDraft {
  id     String @id @default(uuid())
  userId String // tenant (owner of the contact); every query is scoped to this
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status  BreakupDraftStatus @default(PENDING)
  subject String
  body    String             @db.Text

  // Snapshot of the cold-detection signal (staleness window, last-contacted
  // date, contact/pipeline status) and the reasoning + sources the draft was
  // grounded in (activity/email ids referenced), for auditability. Captured at
  // generation time and never re-derived, so the review queue always shows why
  // THIS draft was written even if the underlying history later changes.
  generatedFrom Json?

  createdAt DateTime  @default(now())
  // When the human approved or dismissed it (null while PENDING).
  decidedAt DateTime?

  @@index([userId, status])
  @@index([userId, status, createdAt])
  @@index([contactId])
  @@map("breakup_drafts")
}

// ── Self-optimizing outreach: a bandit over subject/opener variants ────────
//
// The agent silently learns which outreach openers/subject lines get replies,
// per segment, and converges on the best ones without a human ever
// configuring an A/B test. selectVariant (src/lib/variant-operations.ts)
// Thompson-samples over each active variant's Beta(replies+1,
// sends-replies+1) posterior; logOutreach/saveSocialMessage record a
// VariantSend when the agent supplies the variantId it used; an inbound
// reply that advances a contact to REPLIED attributes back to that contact's
// most-recent unreplied send.

enum VariantKind {
  SUBJECT
  OPENER
}

model OutreachVariant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Null = a general-purpose variant used outside any segment. Segment
  // deletion unscopes rather than destroys a variant, so the reply-rate data
  // an agent has already earned on it survives (SetNull), same pattern as
  // Contact.entityId.
  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  kind VariantKind
  text String @db.Text

  // The bandit's running counts. Incremented by recordVariantSend /
  // attributeReply, never written directly by a caller.
  sends   Int     @default(0)
  replies Int     @default(0)
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantSends VariantSend[]

  @@index([userId, kind, segmentId, active])
  @@map("outreach_variants")
}

// A single outbound send of a specific variant to a specific contact - the
// join that makes reply attribution exact. Deliberately NOT a variantId
// column on Activity (see the module docstring in variant-operations.ts):
// this keeps "the most recent unreplied send to this contact" a single
// indexed query instead of a filtered scan over a polymorphic activity log,
// and gives attribution a clean, race-safe terminal state (replied flips
// exactly once - see attributeReply).
model VariantSend {
  id String @id @default(uuid())

  variantId String
  variant   OutreachVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sentAt    DateTime  @default(now())
  replied   Boolean   @default(false)
  repliedAt DateTime?

  @@index([contactId, replied, sentAt])
  @@index([variantId])
  @@map("variant_sends")
}

// ── Provenance spine (Moment 3 - Visible Trust) ─────────────────────────────
//
// One row per (recordType, recordId, field) - the last provider that wrote a
// value, how confident it was, what value it stored, and when. Used by the UI
// to show "via explorium, 3 days ago" on each enriched field and by the
// re-verify scheduler to find stale rows.
//
// recordType: "contact" | "entity"
// field:      column name exactly as stored on the record (e.g. "email", "phone",
//             "linkedin", "industry", "location", "phone", "description", "website")
// source:     short provider slug: "explorium" | "pipe0" | "exa" | "manual" | etc.
// confidence: 0-100 integer; 100 = verified exact match, lower = inferred.
// valueSnapshot: the value we recorded at the time (truncated to 500 chars for
//             large blobs like descriptions so the row stays lean).
// retrievedAt: when the provider returned this value (used for staleness).
// verifiedAt:  last time re-verify confirmed the value is still accurate.
// stale:       true when retrievedAt is older than the re-verify threshold and a
//             re-check has been scheduled but not yet completed.
model FieldProvenance {
  id            String    @id @default(uuid())
  recordType    String // "contact" | "entity"
  recordId      String // contact.id or entity.id
  field         String // column name
  source        String // provider slug
  confidence    Int       @default(80) // 0-100
  valueSnapshot String?   @db.Text
  retrievedAt   DateTime  @default(now())
  verifiedAt    DateTime?
  stale         Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([recordType, recordId, field])
  @@index([recordType, recordId])
  @@index([retrievedAt])
  @@index([stale])
  @@map("field_provenance")
}

// ── Budgeted Autopilot ───────────────────────────────────────────────────────
//
// The problem: today an agent hits a surprise HTTP 402 mid-task when credits
// run out. Instead: the agent proposes a spend plan up front (a total ceiling
// split across categories), a human approves it ONCE (never an agent - see
// approveAutopilotPlan / the session-gated REST route), and the scheduler then
// runs it unsupervised, hard-stopping cleanly at the cap instead of erroring.
//
// The plan's credit ceiling is an ADDITIONAL budget on top of the real user
// credit meter (User.creditsRemaining / spendCredits) - approving a plan never
// grants credits, it only caps how much of the user's real balance the
// autopilot loop is allowed to spend, per category, per window.

enum AutopilotStatus {
  draft // proposed by an agent, not yet runnable
  approved // human approved; about to open its first window (transient)
  active // running unsupervised within budget
  paused // hard-stopped: a category hit its cap, or a human/agent paused it
  exhausted // hard-stopped: the plan's whole budget was spent for this window
  completed // manually retired; kept for history
}

enum AutopilotCategory {
  discovery
  enrichment
  outreach
  other
}

// A proposed/approved spend plan. One row per plan; its per-category ceilings
// live in AutopilotAllocation, and every autonomous action it takes is logged
// to AutopilotRun so the human can audit what the autopilot did.
model AutopilotPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  // How often the plan's window resets and the scheduler re-runs it: "daily" |
  // "weekly" | "hourly" - same vocabulary as IntentMonitor.frequency.
  cadence      String          @default("weekly")
  status       AutopilotStatus @default(draft)
  // The ceiling for one window; mirrors the sum of AutopilotAllocation.allocated
  // (enforced at propose time so the plan's headline number is never a lie).
  totalCredits Int
  // What the discovery step searches for, e.g. "B2B fintech startups in NYC".
  // Optional - a plan with no discoveryQuery only runs enrichment + outreach.
  discoveryQuery String? @db.Text

  windowStart DateTime?
  windowEnd   DateTime?
  approvedAt  DateTime?
  // The human who approved it (users.id) - never an agent; stamped by the
  // session-gated approve route only.
  approvedById String?
  // Why the plan last hard-stopped (category exhausted, full budget spent, or
  // a human/agent pause), shown in the UI so the reason is never a mystery.
  pausedReason String? @db.Text

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations AutopilotAllocation[]
  runs        AutopilotRun[]

  @@index([userId])
  @@index([status, nextRunAt])
  @@map("autopilot_plans")
}

// One row per spend category per plan: the ceiling (allocated) and the running
// total (spent). A dedicated table with real integer columns - not a JSON blob
// - so the budget guard can use a single atomic, conditional SQL UPDATE per
// charge (the exact proven pattern spendCredits already uses for the credit
// meter's atomic decrement), with no hand-rolled JSONB arithmetic, and so the
// per-category numbers are directly queryable for the dashboard bars.
model AutopilotAllocation {
  id     String        @id @default(uuid())
  planId String
  plan   AutopilotPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  category  AutopilotCategory
  allocated Int
  spent     Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, category])
  @@map("autopilot_allocations")
}

// Append-only audit ledger: one row per autonomous action the plan actually
// took (or a zero-cost step like surfacing due follow-ups), so the human can
// see exactly what their autopilot did while they were away.
model AutopilotRun {
  id     String        @id @default(uuid())
  planId String
  plan   AutopilotPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String

  category     AutopilotCategory
  action       String // underlying operation, e.g. "find_companies", "company_aspect", "list_due_followups"
  creditsSpent Int               @default(0)
  ref          String? // the entity/contact id touched, when applicable
  summary      String? @db.Text

  createdAt DateTime @default(now())

  @@index([planId, createdAt])
  @@index([userId])
  @@map("autopilot_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONNECTED ACCOUNTS + MAILBOX/CALENDAR SYNC (via Composio)
// ═══════════════════════════════════════════════════════════════════════════
// Multi-tenant: every row is userId-scoped. Composio holds the OAuth tokens;
// we hold only the connection handle it gives us back. Nothing here stores a
// provider refresh token.

enum ConnectionProvider {
  GMAIL
  GOOGLE_CALENDAR
  OUTLOOK
  OUTLOOK_CALENDAR
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  REVOKED
}

model ConnectedAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider ConnectionProvider

  // Composio identifiers. composioUserId is the per-end-user handle we create
  // on their side; composioConnectionId is what actions execute against.
  composioUserId       String
  composioConnectionId String?
  authConfigId         String?

  status       ConnectionStatus @default(PENDING)
  accountEmail String?
  scopes       String[]         @default([])
  lastError    String?

  connectedAt    DateTime?
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sync     MailboxSync?
  triggers SyncTrigger[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([composioConnectionId])
  @@map("connected_accounts")
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
  PAUSED
}

model MailboxSync {
  id     String @id @default(uuid())
  userId String

  connectedAccountId String           @unique
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  status SyncStatus @default(IDLE)
  cursor String? // provider history/page token

  // Forward-only: nothing before this instant is ever imported. Stamped at
  // connect time so wiring up a ten-year-old mailbox does not dump a decade
  // of mail into the CRM.
  syncFromAt DateTime

  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?

  // Whether an unknown external participant may be auto-created as a Contact.
  // Off by default: creation is a decision, not a side effect of syncing.
  autoCreateContacts Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("mailbox_syncs")
}

model SyncTrigger {
  id     String @id @default(uuid())
  userId String

  connectedAccountId String
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  // Composio trigger slug (e.g. GMAIL_NEW_GMAIL_MESSAGE) + the id it returns
  // when the trigger is enabled for this connection, so we can disable it.
  slug              String
  composioTriggerId String?

  active      Boolean   @default(true)
  lastEventAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectedAccountId, slug])
  @@index([userId])
  @@map("sync_triggers")
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

model EmailThread {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerThreadId String
  subject          String?
  participants     String[] @default([])

  firstMessageAt DateTime?
  lastMessageAt  DateTime?
  messageCount   Int       @default(0)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)

  messages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, providerThreadId])
  @@index([userId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@index([entityId])
  @@map("email_threads")
}

model EmailMessage {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  providerMessageId String
  direction         MailDirection

  fromEmail String
  fromName  String?
  toEmails  String[] @default([])
  ccEmails  String[] @default([])

  subject  String?
  snippet  String? @db.Text
  bodyText String? @db.Text

  // Extracted signature block: the single best evidence source for a job
  // title, because people update a signature the week they are promoted.
  signatureBlock String? @db.Text

  sentAt DateTime

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, providerMessageId])
  @@index([threadId, sentAt])
  @@index([userId, sentAt])
  @@index([contactId, sentAt])
  @@map("email_messages")
}

model CalendarEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerEventId String
  iCalUid         String?

  title         String?
  description   String? @db.Text
  location      String?
  conferenceUrl String?

  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String?
  organizerEmail String?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)

  attendees CalendarAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, providerEventId])
  @@index([userId, startsAt])
  @@index([contactId, startsAt])
  @@index([entityId])
  @@map("calendar_events")
}

model CalendarAttendee {
  id      String        @id @default(uuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean @default(false)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendar_attendees")
}

// ═══════════════════════════════════════════════════════════════════════════
// SUPPRESSION — one list, two directions
// ═══════════════════════════════════════════════════════════════════════════
// INBOUND  = never auto-create a Contact from this address/domain on sync.
// OUTBOUND = never send to it. Checked at send time, globally, ahead of every
//            segment, pipeline and autopilot plan.

enum SuppressionScope {
  INBOUND
  OUTBOUND
  ALL
}

model SuppressedDomain {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain String
  scope  SuppressionScope @default(ALL)
  reason String?

  createdAt DateTime @default(now())

  @@unique([userId, domain])
  @@index([userId, scope])
  @@map("suppressed_domains")
}

model SuppressedContact {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email  String
  scope  SuppressionScope @default(ALL)
  reason String?

  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@index([userId, scope])
  @@map("suppressed_contacts")
}

// ═══════════════════════════════════════════════════════════════════════════
// EVIDENCE LEDGER
// ═══════════════════════════════════════════════════════════════════════════
// The agent never sets a confidence. It reports what it OBSERVED (typed
// evidence kinds) and the ledger prices it. Strong + primary evidence writes
// to the record; anything weaker is held as a PROPOSED suggestion a human
// settles. Polymorphic over contact/entity, matching FieldProvenance.

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

enum FactRecordType {
  CONTACT
  ENTITY
}

model RecordFact {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recordType FactRecordType
  recordId   String

  field String
  value String @db.Text

  score Float
  band  FactBand

  // Evidence[] exactly as observed: [{ kind, detail, sourceUrl }]. One entry
  // per INDEPENDENT source - two facts on the same page are one observation.
  evidence Json

  method    String
  sourceUrl String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([userId, recordType, recordId, field, status])
  @@index([userId, status, observedAt])
  @@map("record_facts")
}

// ═══════════════════════════════════════════════════════════════════════════
// DYNAMIC FIELDS
// ═══════════════════════════════════════════════════════════════════════════
// User-defined columns on contacts/entities/deals. agentBrief is prose the
// operator writes describing what the field means, so the agent can fill it
// without any code change.

enum FieldEntity {
  CONTACT
  ENTITY
  PIPELINE_ENTRY
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  URL
  EMAIL
  PHONE
}

model FieldDefinition {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entity FieldEntity
  key    String
  label  String
  type   FieldType

  // Whether the agent may fill this field, and the prose telling it how.
  agentFilled Boolean @default(true)
  agentBrief  String? @db.Text

  required    Boolean @default(false)
  showOnSheet Boolean @default(true)
  showOnTable Boolean @default(false)
  position    Int     @default(0)

  archivedAt DateTime?

  options FieldOption[]
  values  FieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entity, key])
  @@index([userId, entity, position])
  @@map("field_definitions")
}

model FieldOption {
  id      String          @id @default(uuid())
  fieldId String
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label    String
  value    String
  position Int    @default(0)

  values FieldValue[]

  @@unique([fieldId, value])
  @@index([fieldId, position])
  @@map("field_options")
}

model FieldValue {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fieldId String
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  pipelineEntryId String?
  pipelineEntry   PipelineEntry? @relation(fields: [pipelineEntryId], references: [id], onDelete: Cascade)

  text     String?      @db.Text
  number   Decimal?     @db.Decimal(24, 4)
  date     DateTime?
  bool     Boolean?
  optionId String?
  option   FieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([fieldId, contactId])
  @@unique([fieldId, entityId])
  @@unique([fieldId, pipelineEntryId])
  @@index([userId])
  @@index([contactId])
  @@index([entityId])
  @@index([pipelineEntryId])
  @@index([optionId])
  @@map("field_values")
}

// ═══════════════════════════════════════════════════════════════════════════
// CURRENCY
// ═══════════════════════════════════════════════════════════════════════════
// PipelineEntry.amount/currency is what the customer pays and is NEVER
// converted in place. baseAmount is the only column any sum/chart/sort may
// touch, and the rate is frozen at write time - converting on read makes a
// closed quarter change value every morning.

enum RateSource {
  FETCHED
  MANUAL
}

model ExchangeRate {
  id String @id @default(uuid())

  // Per tenant, like every other table here. A MANUAL rate is an operator's
  // judgement about their own book, so it must never leak across accounts:
  // one tenant correcting their EUR rate would otherwise silently restate
  // every other tenant's pipeline. FETCHED rates are written per tenant too.
  // The duplication is a handful of rows per account and buys unambiguous
  // ownership, which a nullable "global" userId would not: Postgres treats
  // NULLs as distinct in a unique index, so global rows would not dedupe.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseCurrency  String
  quoteCurrency String
  rate          Decimal    @db.Decimal(20, 10)
  asOf          DateTime
  source        RateSource
  provider      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, baseCurrency, quoteCurrency, source])
  @@index([userId, baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

// ═══════════════════════════════════════════════════════════════════════════
// AGENT TASK QUEUE
// ═══════════════════════════════════════════════════════════════════════════
// Replaces "every hour, loop every due row" cron bodies. A schedule decides
// nothing: it leases what is due (FOR UPDATE SKIP LOCKED) and runs one task
// per row. Two dispatchers take disjoint work; a run that dies frees its row
// when the lease expires.

model AgentTask {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind String

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Why this task exists, in words shown to the operator. An agent that
  // cannot say why it will be back in fourteen days does not have a reason,
  // it has a default.
  reason  String  @db.Text
  payload Json?

  priority Int @default(0)
  budget   Int @default(0) // credit ceiling for this one task

  dueAt       DateTime
  leasedUntil DateTime?
  attempts    Int       @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([finishedAt, dueAt, priority])
  @@index([userId, kind, finishedAt])
  @@index([contactId])
  @@index([entityId])
  @@map("agent_tasks")
}

// ═══════════════════════════════════════════════════════════════════════════
// SOCIAL CONTEXT + OPPORTUNITY DISCOVERY (SocQ)
// ═══════════════════════════════════════════════════════════════════════════
// SocQ is a HYDRATION layer, never a resolution layer. It accepts canonical
// URLs/handles and returns rich social context; it accepts no email, no
// domain, and returns no confidence or match score of any kind. So a social
// profile may only ever be hydrated from a URL that our existing resolution
// stack (find_socials, Explorium, Pipe0, Exa) already verified against the
// name AND company rule. A keyword-search result must NEVER create or update
// a contact: there is nothing to threshold on, and attaching result[0] to a
// person is exactly the same-name-stranger bug the accuracy rule forbids.
// Discovery results therefore land in SocialOpportunity, which is a review
// queue, not a record.

enum SocialPlatform {
  LINKEDIN
  X
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  REDDIT
  THREADS
  PINTEREST
}

// Every SocQ call is asynchronous and billed per result, so each submission is
// tracked: the idempotency key makes a retry after a network error free rather
// than double-billed, and the credit amount is reconciled back to our meter.
enum SocqTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model SocqTask {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  socqTaskId     String         @unique
  idempotencyKey String
  platform       String
  resource       String
  status         SocqTaskStatus @default(QUEUED)

  // What this call was for, so a completed task can be routed back to the
  // record or monitor that asked for it.
  purpose   String
  contactId String?
  entityId  String?
  monitorId String?

  resultCount   Int?
  creditsAmount Decimal? @db.Decimal(12, 4)
  errorMessage  String?  @db.Text

  submittedAt DateTime  @default(now())
  finishedAt  DateTime?

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("socq_tasks")
}

model SocialProfile {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  platform   SocialPlatform
  profileUrl String
  handle     String?

  displayName String?
  bio         String? @db.Text
  followers   Int?
  following   Int?
  location    String?

  // Unschematized provider payload: SocQ declares author/metrics/media as
  // additionalProperties with no named sub-fields, and rotates upstream
  // scrapers, so field names drift. Keep the raw blob and parse defensively.
  raw Json?

  socqTaskId  String?
  refreshedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  posts SocialPost[]

  @@unique([userId, platform, profileUrl])
  @@index([userId, contactId])
  @@index([userId, entityId])
  @@map("social_profiles")
}

model SocialPost {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileId String?
  profile   SocialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  platform    SocialPlatform
  postUrl     String
  text        String?        @db.Text
  publishedAt DateTime?
  metrics     Json?
  raw         Json?

  createdAt DateTime @default(now())

  @@unique([userId, postUrl])
  @@index([userId, contactId, publishedAt])
  @@index([userId, entityId, publishedAt])
  @@map("social_posts")
}

// A saved keyword/community watch. Mirrors IntentMonitor's scheduling shape so
// the same leased task queue runs it; kept separate because the result of a
// social watch is a reviewable opportunity, not a CRM record.
model SocialMonitor {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  platform SocialPlatform
  // Either a free-text query, or explicit community/group URLs. There is no
  // group DISCOVERY endpoint anywhere in SocQ, so a group watch requires URLs
  // the operator already has. Never imply we can go find groups for them.
  query           String?
  sourceUrls      String[] @default([])
  resultsLimit    Int      @default(50)
  publishedWithin String?

  active    Boolean   @default(true)
  frequency String    @default("daily")
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities SocialOpportunity[]

  @@index([userId, active])
  @@index([active, nextRunAt])
  @@map("social_monitors")
}

enum OpportunityStatus {
  NEW
  REVIEWED
  DISMISSED
  CONVERTED
}

model SocialOpportunity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monitorId String?
  monitor   SocialMonitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  platform    SocialPlatform
  postUrl     String
  text        String?        @db.Text
  authorRaw   Json?
  publishedAt DateTime?
  metrics     Json?

  // Our own classification, done in our LLM layer: SocQ returns no sentiment,
  // no intent and no scoring of any kind.
  intentScore  Int?
  intentReason String? @db.Text

  status OpportunityStatus @default(NEW)

  // Set only when a human converts the opportunity into a real record. An
  // opportunity NEVER auto-creates a contact: the author of a matching post
  // carries no identity signal we could verify.
  contactId String?
  entityId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postUrl])
  @@index([userId, status, createdAt])
  @@index([monitorId])
  @@map("social_opportunities")
}

// ═══════════════════════════════════════════════════════════════════════════
// TELEPHONY (LiveKit) - in-house voice, replacing AgentPhone
// ═══════════════════════════════════════════════════════════════════════════
// Two hard constraints shape this, both verified against LiveKit source:
//
// 1. The agent WORKER cannot run on Vercel. It holds a persistent WebSocket
//    with a reconnect loop and forks a child process per call, so it needs an
//    always-on deployment (LiveKit Cloud Agents, or Fly/Render/ECS). Only the
//    CONTROL PLANE (trunks, dispatch rules, outbound dial, webhooks) runs in
//    our Next.js routes, and that part is plain stateless HTTPS.
//
// 2. LiveKit does now sell DIDs itself, but inbound-only and US-only, and we
//    need outbound. So numbers are bought from a carrier behind a provider
//    adapter and their SIP trunk is pointed at LiveKit. `provider` exists so
//    that swapping carriers, or moving to LiveKit numbers when outbound
//    lands, is a per-row migration rather than a rewrite.

enum PhoneNumberProvider {
  TELNYX
  TWILIO
  LIVEKIT
}

enum PhoneNumberStatus {
  PENDING
  ACTIVE
  RELEASED
  FAILED
}

model PhoneNumber {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  e164        String
  countryCode String
  areaCode    String?
  numberType  String? // local | toll_free | mobile

  provider         PhoneNumberProvider
  providerNumberId String? // carrier-side sid/id, for release and billing

  // LiveKit wiring. One dispatch rule per DID, pinned to this number and
  // carrying the tenant id, so one agent deployment serves every tenant.
  livekitTrunkId        String?
  livekitDispatchRuleId String?

  status       PhoneNumberStatus @default(PENDING)
  capabilities String[]          @default([])
  // Carrier reputation, surfaced in the buy-a-number UI. A number that is
  // already flagged will get outbound calls tagged as spam.
  spamScore    Float?

  monthlyCostCents Int?
  purchasedAt      DateTime?
  releasedAt       DateTime?
  lastError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls VoiceCall[]

  @@unique([e164])
  @@index([userId, status])
  @@map("phone_numbers")
}

enum VoiceCallDirection {
  INBOUND
  OUTBOUND
}

enum VoiceCallStatus {
  QUEUED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  VOICEMAIL
}

model VoiceCall {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumberId String?
  phoneNumber   PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  direction  VoiceCallDirection
  fromNumber String
  toNumber   String

  livekitRoomName String  @unique
  livekitCallId   String?

  status VoiceCallStatus @default(QUEUED)
  // SIP rejection detail (busy, no answer, blocked), needed for retry policy
  // and so a failed dial is never billed as a conversation.
  sipStatusCode Int?
  sipStatus     String?

  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  recordingUrl String?
  transcript   Json?
  // Per-model token/character spend for this call, read off the agent session
  // so cost is attributed per tenant rather than averaged.
  modelUsage   Json?

  creditsCharged Int?
  systemPrompt   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
  @@map("voice_calls")
}

// ═══════════════════════════════════════════════════════════════════════════
// SEQUENCES - the autonomy backbone for outreach
// ═══════════════════════════════════════════════════════════════════════════
// A Sequence is an ordered multi-step cadence (touch 1, wait N days, touch 2,
// ...). Enrolling a contact is what turns the one-shot send path into
// self-driving outreach: the leased task queue advances each enrollment on its
// own schedule and sends through the SAME chokepoint (src/lib/email-send.ts),
// so suppression, the daily cap, and the unsubscribe link are enforced on every
// automated touch exactly as on a manual one. An enrollment stops the instant
// the contact replies or is suppressed - a reply is the goal, not a step to
// talk over.

enum SequenceStepChannel {
  EMAIL
}

model Sequence {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  active Boolean @default(true)

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@map("sequences")
}

model SequenceStep {
  id         String   @id @default(uuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  // 0-based position in the cadence.
  order   Int
  channel SequenceStepChannel @default(EMAIL)

  // Days to wait AFTER the prior step before this one fires. Step 0's delay is
  // the wait after enrollment. Business-day awareness and per-contact timezone
  // are handled by the send window in email-send.ts, not duplicated here.
  delayDays Int @default(0)

  subject String
  body    String @db.Text

  @@unique([sequenceId, order])
  @@index([sequenceId])
  @@map("sequence_steps")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAILED
}

model SequenceEnrollment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status EnrollmentStatus @default(ACTIVE)
  // Which step fires next (0-based). Advanced after each send.
  currentStep Int              @default(0)
  nextStepAt  DateTime?
  // Why an enrollment left ACTIVE: "replied", "suppressed", "completed",
  // "no email", a send error. Shown to the operator, so the agent never has to
  // guess why a contact stopped receiving touches.
  stoppedReason String?

  lastStepAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One active enrollment per (contact, sequence): re-enrolling a contact
  // already in a sequence is a no-op, not a second cadence talking over itself.
  @@unique([sequenceId, contactId])
  @@index([status, nextStepAt])
  @@index([userId, status])
  @@index([contactId])
  @@map("sequence_enrollments")
}
